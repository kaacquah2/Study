{
	"name": "study",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "node -e \"if (!require('fs').existsSync('.env') && require('fs').existsSync('.env.example')) require('fs').copyFileSync('.env.example', '.env')\" && (svelte-kit sync || echo '')",
		"check": "node -e \"if (!require('fs').existsSync('.env') && require('fs').existsSync('.env.example')) require('fs').copyFileSync('.env.example', '.env')\" && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project=server",
		"test:pipeline": "vitest run src/routes/api/pipeline.integration.test.ts",
		"test:rules": "vitest run --project=rules",
		"test:rules:emulator": "npx firebase-tools emulators:exec --only firestore \"vitest run --project=rules\"",
		"test:e2e": "playwright install && playwright test",
		"test:e2e:ui": "playwright test tests/userJourney.e2e.ts tests/responsiveLayout.e2e.ts",
		"test:e2e:hermetic": "playwright test tests/fullPipeline.hermetic.e2e.ts",
		"test": "npm run test:unit -- --run && npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^5.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/poppins": "^5.2.7",
		"@lucide/svelte": "^1.24.0",
		"elkjs": "^0.12.0",
		"firebase": "^12.16.0",
		"firebase-admin": "^14.1.0",
		"isomorphic-dompurify": "^3.18.0",
		"marked": "^18.0.6",
		"zod": "^4.4.3"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"uuid": "^11.1.1"
	}
}
