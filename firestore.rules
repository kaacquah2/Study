rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn()  { return request.auth != null; }
    function isOwner(uid){ return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // client may only change theme; streak is server-authoritative
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme']);
      allow create, delete: if false;

      match /progress/{courseId} {
        allow read: if isOwner(uid);
        allow write: if false;                 // Server-authoritative via /api/modules/[id]/complete
      }
    }

    match /courses/{courseId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow write: if false;                  // Admin SDK only
      
      match /modules/{moduleId} {
        allow read: if isOwner(resource.data.ownerUid);
        allow write: if false;
      }
    }

    match /sharedCourses/{token} {
      // Capability-based access: any signed-in user with the exact secret token can get the active share
      allow get: if signedIn() && resource.data.revoked == false;
      // Catalogue enumeration: only explicitly published community courses can be queried/listed
      allow list: if signedIn()
                  && resource.data.isPublic == true
                  && resource.data.revoked == false;
      allow write: if false;                                 // Admin SDK only
    }

    match /usage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /flashcards/{cardId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if false; // Server-authoritative via /api/spaced-repetition & /api/documents/flashcards
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['question', 'answer', 'front', 'back', 'tags', 'updatedAt']);
    }

    match /weakTopics/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Server-authoritative via /api/quiz/complete & review logs
    }

    // Server-only design: Group creation/mutation is routed exclusively through Admin SDK (/api/study-groups).
    // Do NOT add client create/write rules here without implementing full owner validation.
    match /studyGroups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false; // Admin SDK only via /api/study-groups
    }

    // Learning events — read owner only; write strictly via Admin SDK (/api/analytics/events)
    match /learningEvents/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Aggregated user learning profile — server authoritative via Admin SDK
    match /userLearningProfile/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Mistake records & error bank — server authoritative via Admin SDK
    match /mistakeRecords/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /mistakes/{questionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Peer questions lifecycle security:
    // - Anyone authenticated can read approved questions or their own submissions.
    // - Creation is routed exclusively through /api/courses/peer-questions (Admin SDK) with moderation and rate limiting.
    // - Direct client writes (create, update, delete) are disallowed.
    match /peerQuestions/{questionId} {
      allow read: if signedIn() && (resource.data.status == 'approved' || resource.data.submittedBy == request.auth.uid);
      allow write: if false;
    }
  }
}

