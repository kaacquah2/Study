# ML Backend Environment Variables

# ── Environment ────────────────────────────────────────────────────────────────
# Set to 'production' to enforce strict security validations (e.g. non-empty API keys)
APP_ENV=development

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# Shared API key between SvelteKit and the ML backend.
# Leave empty to disable auth (local development only).
ML_BACKEND_API_KEY=
# Shared HMAC-SHA256 secret for request signature verification.
# When set, verifies X-Signature, X-Timestamp, and X-Nonce on all requests (replay attack defense).
ML_BACKEND_SECRET=

# CORS allowed origins (comma-separated). Set to your Netlify/production domain.
# Defaults to "*" if empty or unset.
ALLOWED_ORIGINS=*

# ── Model IDs ──────────────────────────────────────────────────────────────────
# Set these to your fine-tuned HuggingFace Hub model IDs after training.
# Leave as defaults to use the base models (no fine-tuning).

# Fine-tuned (or base) models
SUMMARIZER_MODEL_ID=google/flan-t5-base
PARAPHRASER_MODEL_ID=google/flan-t5-base

# Base models (larger; lazy-loaded on first request)
OUTLINE_MODEL_ID=google/flan-t5-large
LESSON_MODEL_ID=google/flan-t5-large

# Quiz generation pipeline
QUIZ_QG_MODEL_ID=valhalla/t5-small-qg-prepend
QUIZ_DG_MODEL_ID=potsawee/t5-large-generation-race-Distractor

# Chat assistant
CHAT_MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# ── RAG Vector Store ───────────────────────────────────────────────────────────
EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=vector_store/index.faiss
FAISS_DOCS_PATH=vector_store/docs.json

# ── Cache Configuration ────────────────────────────────────────────────────────
ENABLE_REDIS=true
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_COOLDOWN=60.0
CACHE_IN_MEMORY_MAXSIZE=1000
CACHE_IN_MEMORY_TTL=86400
