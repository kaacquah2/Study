# Firebase Client configuration (Defaults for local emulator)
PUBLIC_FIREBASE_API_KEY=demo-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=ai-study-buddy-knust.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=ai-study-buddy-knust
FIREBASE_PROJECT_ID=ai-study-buddy-knust
PUBLIC_FIREBASE_STORAGE_BUCKET=ai-study-buddy-knust.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
PUBLIC_FIREBASE_APP_ID=1:1234567890:web:1234567890

# Set to true only if running local Firebase emulators (`firebase emulators:start`)
PUBLIC_FIREBASE_USE_EMULATOR=false
# Optional local emulator host settings (set when running local emulators)
# FIRESTORE_EMULATOR_HOST=localhost:8085
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ML Backend configuration (self-hosted Python FastAPI server)
# Local development: start ml_backend with `uvicorn main:app --port 8000`
# Production: deploy ml_backend to Render.com and set the deployed URL here
ML_BACKEND_URL=http://127.0.0.1:8000
ML_BACKEND_API_KEY=
# Shared secret for HMAC-SHA256 nonced request signing (dual-layer defense against spoofing/replay)
# When configured, SvelteKit signs all requests to ml_backend with timestamp, nonce, and payload HMAC.
ML_BACKEND_SECRET=

# Optional ML Backend settings
# APP_ENV=development
# ALLOWED_ORIGINS=http://localhost:5173

# Gemini API Key & Model Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ollama Local LLM Provider (Tier 2 Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Distributed Upstash Redis REST API (Optional for serverless rate limiting & caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# YouTube Data API v3 Key (Supplementary Video Fetching)
# Free quota: 10,000 units/day (~100 search calls). Cached in Firestore per module.
YOUTUBE_API_KEY=

# Firebase Admin configuration (Production only)
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'

# Durable Task Worker & Cloud Tasks Configuration (Option A)
# Internal worker authorization secret (protects /api/internal/worker endpoints). Required in production.
INTERNAL_WORKER_SECRET=
# Optional production worker URL / Cloud Tasks settings
# WORKER_URL=https://your-domain.netlify.app
# GCP_PROJECT_ID=ai-study-buddy-knust
# CLOUD_TASKS_LOCATION=us-central1
# CLOUD_TASKS_QUEUE_NAME=course-generation-queue

